# Painel do Reveza AI. Só estas duas variáveis entram no front: a URL do Supabase e a chave PÚBLICA (anon).
# A chave de serviço (service_role) NUNCA vai para cá. Copie para .env.local e preencha.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
# Opcional: de onde o instalador é baixado, para os comandos que o painel mostra (padrão: <dono>/reveza).
VITE_REVEZA_REPO=
